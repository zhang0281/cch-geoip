# MaxMind download credentials; do not commit a populated .env.
# Account and key instructions: docs/ACCOUNTS.md
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Optional local CN province/city/ISP enrichment. The GHCR image bundles pinned ip2region v3.18.0 xdb files.
IP2REGION_ENABLED=true
IP2REGION_VERSION=v3.18.0
# Foreign IPs: persistent cache -> IP.SB -> ipwho.is -> GeoJS -> GeoLite2.
# Domestic IPs: IP.SB cache -> IP.SB -> ip2region -> GeoLite2 (no ipwho.is/GeoJS).
# All three online providers require no account or API key.
ONLINE_GEO_ENABLED=true
ONLINE_GEO_CACHE_TTL=24h
ONLINE_GEO_TIMEOUT=2s
IPSB_DAILY_BUDGET=900
GEOJS_DAILY_BUDGET=900
IPWHO_IS_DAILY_BUDGET=900
# Source build default; set to ghcr.io/zhang0281/cch-geoip:<version> after publishing.
CCH_GEOIP_IMAGE=cch-geoip:local
GEOIP_HOST_PORT=8080
# Optional CCH IP_GEO_API_TOKEN. Recommended if reachable beyond the Docker network.
GEOIP_API_TOKEN=
# Local feed downloads only; query IPs stay local.
THREAT_FEEDS_ENABLED=true
# Master opt-in; BLACKLIST and CHECK use the same key.
# BLACKLIST downloads a local snapshot. Only CHECK sends queried IPs upstream.
ABUSEIPDB_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_BLACKLIST_ENABLED=true
# Set false for local-only reputation (no per-IP outbound queries).
ABUSEIPDB_CHECK_ENABLED=true
ABUSEIPDB_DAILY_BUDGET=900
